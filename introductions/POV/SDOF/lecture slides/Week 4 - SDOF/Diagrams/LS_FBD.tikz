\begin{tikzpicture}[every node/.style={outer sep=0pt,thick},scale=0.7]
\footnotesize
 \draw [ultra thick] (0cm,0cm) arc (290:430:0.7);
 \draw [ultra thick] (0cm,0cm) -- (1.4cm,-1.4cm);
 \draw [ultra thick] (0cm, 1.3cm) -- (1.4cm,2.8cm);

 \draw [ thick] (0.7cm,0cm) arc (290:430:0.7);
 \draw [ thick] (0.7cm,0cm) -- (2.1cm,-1.4cm);
 \draw [ thick] (0.7cm, 1.3cm) -- (2.1cm,2.8cm);

\draw [-latex,color=green] (-1.5cm,0.7cm) -- (0.25cm,0.7cm) node[pos=0.5,midway,yshift=0.25cm, text width = 3.25cm,color=green] {Ext. force, $ F_{ext}$};

\draw [-latex,<->] (0.55cm,0.7cm) -- (1.05cm,0.7cm) node[pos=1,right, yshift=-0.025cm,xshift = 0.2cm, text width = 3.5cm] {Diaphragm mass, $m$};

\draw [-latex,red] (4.5cm,2cm) -- (1.5cm,2cm) node[pos=.9,right,yshift=0.25cm,color=red] {Resistive  force, $F_c$};

\draw [-latex,blue] (4.5cm,-0.6cm) -- (1.5cm,-0.6cm) node[pos=.9,right,yshift=-0.3cm,color=blue] {Elastic  force, $F_k$};

\draw [-latex, thick] (0cm,-1.85cm) -- (1.9cm,-1.85cm) node[pos=0.95,yshift=-0.35cm, text width = 3.5cm] {Displacement, $x$};


